# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev artifacts
.shots/
*.sh
# ...but track the portable deploy script (needed by cloud/phone sessions)
!scripts/deploy.sh

# typescript
*.tsbuildinfo
next-env.d.ts

# Brainstorming visual companion (local mockups)
.superpowers/

# Vendored skills toolkit (heygen hyperframes) — re-fetchable from skills-lock.json
.agents/

# Local Netlify folder
.netlify
scripts/.a2p-state.env

# Local agent/session folders
.claude/
.hermes/
