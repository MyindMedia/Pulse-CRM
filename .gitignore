# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local dev artifacts
.shots/
*.sh
# ...but track the portable deploy script (needed by cloud/phone sessions)
!scripts/deploy.sh
# ...and the armed monitor's deploy + hand-run scripts. MYI-266: the blanket
# `*.sh` above is why `scripts/cf/deploy-uptime-watch.sh` was never on main —
# `git add` reported nothing and `git status` showed nothing, so the only copy
# of the live monitor's deploy path sat on an unmerged branch for two weeks.
!scripts/cf/deploy-uptime-watch.sh
!scripts/uptime-check.sh

# typescript
*.tsbuildinfo
next-env.d.ts

# Brainstorming visual companion (local mockups)
.superpowers/

# Vendored skills toolkit (heygen hyperframes) — re-fetchable from skills-lock.json
.agents/

# Local Netlify folder
.netlify
scripts/.a2p-state.env

# Local agent/session folders
.claude/
.hermes/

# clone-ui captures (regenerable); plan files are committed
.clone-ui/source/
