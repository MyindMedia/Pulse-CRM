# ─────────────────────────────────────────────────────────────
# Pulse — environment
# Minimum to run: CONVEX. Clerk + OpenAI unlock auth and AI.
# ─────────────────────────────────────────────────────────────

# CONVEX  — `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL here automatically.
NEXT_PUBLIC_CONVEX_URL=

# CLERK (optional for demo) — https://dashboard.clerk.com
# When set, Pulse switches from demo mode to real multi-tenant auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Set these on the CONVEX dashboard (Settings → Environment Variables),
#     NOT here — Convex functions run on Convex's servers. ───
# CLERK_JWT_ISSUER_DOMAIN   — Clerk → JWT Templates → "convex" template issuer
# CLERK_WEBHOOK_SECRET      — Clerk → Webhooks → signing secret
# OPENAI_API_KEY            — https://platform.openai.com/api-keys
# Receipt reading also requires available OpenAI API credits.
# PLAID_ENV                 — sandbox until production access is approved
# PLAID_CLIENT_ID           — Plaid dashboard client ID
# PLAID_SECRET              — secret for the selected Plaid environment
# PLAID_TOKEN_KEY           — base64 of 32 random bytes; retain securely for existing connections
