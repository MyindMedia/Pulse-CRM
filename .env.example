# ─────────────────────────────────────────────────────────────
# Pulse — environment
# Minimum to run: CONVEX. Clerk + OpenAI unlock auth and AI.
# ─────────────────────────────────────────────────────────────

# CONVEX  — `npx convex dev` writes NEXT_PUBLIC_CONVEX_URL here automatically.
NEXT_PUBLIC_CONVEX_URL=

# CLERK (optional for demo) — https://dashboard.clerk.com
# When set, Pulse switches from demo mode to real multi-tenant auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ─── Set these on the CONVEX dashboard (Settings → Environment Variables),
#     NOT here — Convex functions run on Convex's servers. ───
# CLERK_JWT_ISSUER_DOMAIN   — Clerk → JWT Templates → "convex" template issuer
# CLERK_WEBHOOK_SECRET      — Clerk → Webhooks → signing secret
# OPENAI_API_KEY            — https://platform.openai.com/api-keys
# Receipt reading also requires available OpenAI API credits.
# PLAID_ENV                 — sandbox until production access is approved
# PLAID_CLIENT_ID           — Plaid dashboard client ID
# PLAID_SECRET              — secret for the selected Plaid environment
# PLAID_TOKEN_KEY           — base64 of 32 random bytes; retain securely for existing connections
#
# Cloudflare R2 file storage (scripts/r2/set-convex-env.sh sets the first seven):
# R2_ENDPOINT, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY  — S3 API access to the account
# R2_MEDIA_BUCKET, R2_PRIVATE_BUCKET                   — shared buckets (pulse-media, pulse-private)
# R2_KEY_PREFIX                                        — dev | prod, first segment of every key
# R2_PUBLIC_URL                                        — the pulse-media Worker URL
# Per-studio buckets (docs/R2-PER-ORG-BUCKETS.md), all optional until rollout:
# R2_PER_ORG_BUCKETS     — 1 to give every studio its own two buckets (off = shared buckets)
# CF_R2_ADMIN_TOKEN      — Cloudflare API token allowed to create R2 buckets (Workers R2 Storage: Edit)
# CF_ACCT                — Cloudflare account id (defaults to the one in R2_ENDPOINT)
# R2_BUCKET_ENV          — env label in bucket names (defaults to R2_KEY_PREFIX)
# R2_CORS_ORIGINS        — comma list of origins allowed to PUT uploads (default *)
# R2_BUCKET_QUOTA        — account bucket limit the backfill checks against (default 1000)
#
# Stripe (platform billing). Set on the CONVEX dashboard, never in the repo.
# STRIPE_SECRET_KEY              — sk_live_ / sk_test_ (or a restricted rk_ key)
# STRIPE_WEBHOOK_SECRET          — platform webhook signing secret
# STRIPE_CONNECT_WEBHOOK_SECRET  — Connect webhook signing secret
# Core / Growth / Max price ids (docs/STRIPE-NEW-TIERS.md lists what to create).
# When a price id is unset, /pricing falls back to "Book a demo" for that plan.
# STRIPE_PRICE_CORE_MONTHLY      — $149 / month
# STRIPE_PRICE_CORE_ANNUAL       — $1,490 / year
# STRIPE_PRICE_GROWTH_MONTHLY    — $297 / month
# STRIPE_PRICE_GROWTH_ANNUAL     — $2,970 / year
# STRIPE_PRICE_MAX_MONTHLY       — $699 / month (unlimited studios)
# STRIPE_PRICE_MAX_ANNUAL        — $6,990 / year (unlimited studios)

# ---- /mypulse (internal sales sheet) ----
# Shared password for the /mypulse gate. Netlify env only, never committed.
# Unset or empty = the page stays locked for everyone (fails closed).
MYPULSE_PASSWORD=

# ---- Pulse iPhone app link on /pricing and the JSON-LD (optional) ----
# Overrides APP_STORE_URL in src/components/marketing/app-store.ts.
NEXT_PUBLIC_PULSE_IOS_APP_URL=
